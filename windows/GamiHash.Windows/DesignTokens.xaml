<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Authentic Memory Brand Kit v1.0 (October 2026), the same tokens as
       frontend/src/style.css and authenticmemory.org: mostly white, ink for
       text, petrol for actions, light blue for what is confirmed, coral for the
       heading's full stop and for warnings. -->
  <Color x:Key="BgColor">#FFFFFF</Color>
  <Color x:Key="SandFaintColor">#FAF7F1</Color>
  <Color x:Key="InkColor">#0E1712</Color>
  <Color x:Key="InkSoftColor">#34424A</Color>
  <Color x:Key="InkFaintColor">#56606A</Color>
  <Color x:Key="ShadeColor">#A2A8B1</Color>
  <Color x:Key="RuleColor">#E2E5E8</Color>
  <Color x:Key="RuleSoftColor">#F1F3F4</Color>
  <Color x:Key="BrandColor">#173A4B</Color>
  <Color x:Key="BrandDeepColor">#0F2A37</Color>
  <Color x:Key="TintColor">#C0E1FF</Color>
  <Color x:Key="TintSoftColor">#E3F0FD</Color>
  <Color x:Key="TintFaintColor">#F4F9FF</Color>
  <Color x:Key="AccentColor">#F39F7F</Color>
  <Color x:Key="AccentStrongColor">#7E3219</Color>
  <Color x:Key="AccentBgColor">#FDF0EA</Color>
  <Color x:Key="AccentBorderColor">#F8CFBF</Color>
  <Color x:Key="DangerColor">#9F1239</Color>
  <Color x:Key="DangerBgColor">#FDF5F7</Color>
  <Color x:Key="DangerBorderColor">#F5D9DF</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SandFaint" Color="{StaticResource SandFaintColor}" />
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
  <SolidColorBrush x:Key="InkFaint" Color="{StaticResource InkFaintColor}" />
  <SolidColorBrush x:Key="Shade" Color="{StaticResource ShadeColor}" />
  <SolidColorBrush x:Key="Rule" Color="{StaticResource RuleColor}" />
  <SolidColorBrush x:Key="RuleSoft" Color="{StaticResource RuleSoftColor}" />
  <SolidColorBrush x:Key="Brand" Color="{StaticResource BrandColor}" />
  <SolidColorBrush x:Key="BrandDeep" Color="{StaticResource BrandDeepColor}" />
  <SolidColorBrush x:Key="Tint" Color="{StaticResource TintColor}" />
  <SolidColorBrush x:Key="TintSoft" Color="{StaticResource TintSoftColor}" />
  <SolidColorBrush x:Key="TintFaint" Color="{StaticResource TintFaintColor}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentStrong" Color="{StaticResource AccentStrongColor}" />
  <SolidColorBrush x:Key="AccentBg" Color="{StaticResource AccentBgColor}" />
  <SolidColorBrush x:Key="AccentBorder" Color="{StaticResource AccentBorderColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerBg" Color="{StaticResource DangerBgColor}" />
  <SolidColorBrush x:Key="DangerBorder" Color="{StaticResource DangerBorderColor}" />

  <!-- These names match the fonts' internal family metadata. Relative pack
       URIs are required for resources embedded in this WPF assembly.
       "Raleway Heading" is a static instance of the brand kit's Raleway at
       weight 450 (the website's heading weight): WPF cannot set variation
       axes and would render the variable font's default instance, Thin. -->
  <FontFamily x:Key="SansFont">./Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="HeadFont">./Assets/Fonts/#Raleway Heading</FontFamily>
  <FontFamily x:Key="MonoFont">./Assets/Fonts/#JetBrains Mono</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Headings in Raleway with lining figures. A final full stop becomes the
       coral square through Brand.Heading (Brand.cs). -->
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="24.75" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Small uppercase label above a value, the website's label style. -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="PathText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- One view of the wizard: a white card with a hairline. -->
  <Style x:Key="ViewCard" TargetType="Border">
    <Setter Property="Width" Value="640" />
    <Setter Property="Padding" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>

  <!-- Paths: mono on the light sand of the brand's code blocks. -->
  <Style x:Key="PathCard" TargetType="Border">
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource SandFaint}" />
  </Style>

  <Style x:Key="WarningCard" TargetType="Border">
    <Setter Property="Padding" Value="16,13" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource AccentBg}" />
  </Style>

  <!-- Pill buttons as on the website: the primary action filled petrol. -->
  <Style x:Key="PillButton" TargetType="Button">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Brand}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                     FontFamily="{StaticResource SansFont}" FontSize="14" FontWeight="SemiBold" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="22">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource BrandDeep}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrandDeep}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Opacity" Value="0.86" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary action: outlined in petrol, filling on hover. -->
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
    <Setter Property="Foreground" Value="{StaticResource Brand}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Brand}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rounded progress bar in petrol. While files are counted the bar is
       indeterminate: WPF then sizes the indicator to the full track, and the
       trigger lets it pulse softly, as the Linux and macOS window does. -->
  <Style x:Key="GamiProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Background" Value="{StaticResource RuleSoft}" />
    <Setter Property="Foreground" Value="{StaticResource Brand}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                    HorizontalAlignment="Left" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity"
                                     From="0.15" To="0.45" Duration="0:0:1.25" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Pulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="31" /><Setter Property="Height" Value="31" />
    <Setter Property="Margin" Value="2,12" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource InkFaint}" />
    <Setter Property="FontFamily" Value="Segoe UI Symbol" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#0D0E1712" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource DangerBg}" />
              <Setter Property="Foreground" Value="{StaticResource Danger}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
