<Window x:Class="GamiHash.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:GamiHash.Windows"
        Title="Authentic Memory Hashing Tool" Width="980" Height="720"
        MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: the brand kit lockup in petrol, a hairline, the tool name. -->
    <Border Grid.Row="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
      <Grid Margin="40,0,12,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="{StaticResource LockupGeometry}" Fill="{StaticResource Brand}" Height="36" Stretch="Uniform"
                SnapsToDevicePixels="False" AutomationProperties.Name="Authentic Memory" />
          <Rectangle Width="1" Height="22" Fill="{StaticResource Rule}" Margin="14,0" VerticalAlignment="Center" />
          <TextBlock Text="Hashing Tool" FontSize="13.5" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" Content="―" AutomationProperties.Name="Minimize" />
          <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" Content="□" AutomationProperties.Name="Maximize" />
          <Button Style="{StaticResource CloseButton}" Click="Close_Click" Content="×" AutomationProperties.Name="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="48,24">
      <Border x:Name="WelcomeView" Style="{StaticResource ViewCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" FontSize="30" LineHeight="37"
                     local:Brand.Heading="Create a checksum list of your collection." />
          <TextBlock Style="{StaticResource Body}"
                     Text="The program reads every file in a folder you choose and writes one CSV file with a SHA-256 checksum per file, for handover to Authentic Memory. Your files are only read. Nothing is changed, moved or deleted." />
          <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="You can stop at any time and continue later." />

          <Border x:Name="ResumeCard" Visibility="Collapsed" Margin="0,26,0,0" Padding="18,15"
                  BorderBrush="{StaticResource TintSoft}" BorderThickness="1" CornerRadius="12" Background="{StaticResource TintFaint}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="INTERRUPTED RUN" />
                <TextBlock x:Name="ResumeCount" Text="80 files recorded so far" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock x:Name="ResumePath" Text="C:\projects\gami-hash\stage3-resume-fixture" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource InkSoft}" FontSize="12" Margin="0,4,18,0" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource PillButton}" Click="Resume_Click" Content="Continue" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Style="{StaticResource PillButton}" Click="ChooseFolder_Click" Content="Choose folder" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="SelectedView" Visibility="Collapsed" Style="{StaticResource ViewCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" local:Brand.Heading="Folder selected." />
          <TextBlock Style="{StaticResource Body}"
                     Text="All files in this folder and its subfolders will be recorded. Links and special files are skipped and noted in the report." />
          <Border Style="{StaticResource PathCard}" Margin="0,18">
            <StackPanel>
              <TextBlock Style="{StaticResource Label}" Text="FOLDER" />
              <TextBlock x:Name="SelectedPath" Style="{StaticResource PathText}" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="Back_Click" Content="Back" Margin="0,0,10,0" />
            <Button Style="{StaticResource PillButton}" Click="ChooseOutput_Click" Content="Choose where to save" MinWidth="184" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ReadyView" Visibility="Collapsed" Style="{StaticResource ViewCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" local:Brand.Heading="Ready to start." />
          <TextBlock Style="{StaticResource Body}"
                     Text="Depending on the amount of data this can take several hours. You can keep using the computer, and you can stop and continue later at any time." />
          <Border Style="{StaticResource PathCard}" Margin="0,18" Padding="0">
            <StackPanel>
              <StackPanel Margin="16,13">
                <TextBlock Style="{StaticResource Label}" Text="FOLDER" />
                <TextBlock x:Name="ReviewRoot" Style="{StaticResource PathText}" />
              </StackPanel>
              <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" />
              <StackPanel Margin="16,13">
                <TextBlock Style="{StaticResource Label}" Text="RESULT FILE" />
                <TextBlock x:Name="ReviewOutput" Style="{StaticResource PathText}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="StorageNotice" Visibility="Collapsed" Style="{StaticResource WarningCard}" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="Network, cloud, or uncertain storage" Foreground="{StaticResource AccentStrong}" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock x:Name="StorageNoticeText" Foreground="{StaticResource AccentStrong}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="ChangeOutput_Click" Content="Change" Margin="0,0,10,0" />
            <Button x:Name="StartButton" Style="{StaticResource PillButton}" Click="Start_Click" Content="Start" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ConflictView" Visibility="Collapsed" Style="{StaticResource ViewCard}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" local:Brand.Heading="This file belongs to a different folder." />
          <TextBlock x:Name="ConflictSummary" Style="{StaticResource Body}" />
          <Border Style="{StaticResource PathCard}" Margin="0,18,0,8">
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="RECORDED EARLIER" /><TextBlock x:Name="ConflictEarlierRoot" Style="{StaticResource PathText}" /></StackPanel>
          </Border>
          <Border Style="{StaticResource PathCard}" Margin="0,0,0,18">
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="SELECTED NOW" /><TextBlock x:Name="ConflictSelectedRoot" Style="{StaticResource PathText}" /></StackPanel>
          </Border>
          <TextBlock Text="Continue only if this is the same folder at a new location. Otherwise, choose a new result filename." Foreground="{StaticResource InkSoft}" FontSize="14" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="ChooseDifferentOutput_Click" Content="Choose another file" Margin="0,0,10,0" />
            <Button Style="{StaticResource PillButton}" Click="ContinueEarlier_Click" Content="Continue earlier run" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ProgressView" Visibility="Collapsed" Style="{StaticResource ViewCard}">
        <StackPanel>
          <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}" Text="Counting files" Margin="0,0,0,8" />
          <TextBlock x:Name="ProgressDetail" Foreground="{StaticResource InkSoft}" FontSize="15" />
          <ProgressBar x:Name="ProgressBar" Style="{StaticResource GamiProgressBar}" Margin="0,24,0,24" Minimum="0" Maximum="100" />
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Padding="16" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="FILES" /><TextBlock x:Name="FilesText" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel></Border>
            <Border Grid.Column="1" Padding="16" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Label}" Text="DATA READ" /><TextBlock x:Name="BytesText" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Padding="16" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Style="{StaticResource Label}" Text="ELAPSED" /><TextBlock x:Name="ElapsedText" FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource PathCard}" Padding="16,13">
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="RESULT FILE" /><TextBlock x:Name="ProgressOutput" Style="{StaticResource PathText}" /></StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Content="Cancel" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ResultView" Visibility="Collapsed" Style="{StaticResource ViewCard}">
        <StackPanel HorizontalAlignment="Stretch">
          <Border x:Name="ResultIconCircle" Width="54" Height="54" CornerRadius="27" Background="{StaticResource Tint}" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock x:Name="ResultIcon" Text="✓" Foreground="{StaticResource Brand}" FontSize="27" TextAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="ResultTitle" Style="{StaticResource Heading}" TextAlignment="Center" Margin="0" local:Brand.Heading="Done." />
          <TextBlock x:Name="ResultSummary" Foreground="{StaticResource InkSoft}" FontSize="15" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" />
          <Border x:Name="ResultWarning" Visibility="Collapsed" Style="{StaticResource WarningCard}" Margin="0,18,0,0">
            <TextBlock x:Name="ResultWarningText" Foreground="{StaticResource AccentStrong}" FontSize="13.5" TextWrapping="Wrap" />
          </Border>
          <Border x:Name="ResultOutputCard" Style="{StaticResource PathCard}" Padding="16,13" Margin="0,20">
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="RESULT FILE" /><TextBlock x:Name="ResultOutput" Style="{StaticResource PathText}" /></StackPanel>
          </Border>
          <TextBlock x:Name="ResultInstruction" Text="Please send the result file to tech@authenticmemory.org." Foreground="{StaticResource InkSoft}" FontSize="15" TextAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button x:Name="ResultHomeButton" Style="{StaticResource SecondaryButton}" Click="Home_Click" Content="Close" />
            <Button x:Name="ContinueNowButton" Visibility="Collapsed" Style="{StaticResource PillButton}" Click="ContinueNow_Click" Content="Continue now" Margin="10,0,0,0" />
            <Button x:Name="OpenFolderButton" Visibility="Collapsed" Style="{StaticResource PillButton}" Click="OpenFolder_Click" Content="Open folder" Margin="10,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
